<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent"
    tools:context=".ui.video.VideoDescribeFragment">
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        app:cardCornerRadius="11dp"
        app:cardElevation="11dp"
        android:tag="themed|background">
        <!--
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clAuthorInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivAvatar"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/ic_launcher_background"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/CircleImageViewStyle" />

            <TextView
                android:id="@+id/tvAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="25sp"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/ivAvatar" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        -->
        <include layout="@layout/card_profile_top" android:id="@+id/clAuthorInfo"/>
    </com.google.android.material.card.MaterialCardView>
    <!-- TODO: Update blank fragment layout -->
    <TextView
        android:textIsSelectable="true"
        android:tag="themed|"
        android:id="@+id/video_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:textSize="24sp"
        android:text="TITLE" />

    <LinearLayout
        android:layout_width="match_parent"
        android:nestedScrollingEnabled="true"
        android:orientation="vertical"
        android:layout_height="wrap_content">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:textIsSelectable="true"
                android:autoLink="all"
                android:tag="themed|"
                android:id="@+id/video_desc_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DESCRIBE"
                android:textColor="@color/black"
                app:layout_constraintTop_toTopOf="parent" />

            <include
                android:id="@+id/action_bar"
                layout="@layout/action_bar_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/video_desc_text" />

            <HorizontalScrollView
                android:id="@+id/scrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/action_bar">

                <LinearLayout
                    android:id="@+id/llTagsArea"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <com.google.android.material.textview.MaterialTextView
                android:textSize="22sp"
                android:layout_width="wrap_content"
                android:id="@+id/mtv"
                android:layout_height="wrap_content"
                android:tag="themed"
                android:text="@string/recommend"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/scrollView" />
            <org.eu.hanana.reimu.ottohub_andriod.util.TouchInterceptFrameLayout
                android:id="@+id/fragment_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:layout_constraintTop_toBottomOf="@id/mtv">

            </org.eu.hanana.reimu.ottohub_andriod.util.TouchInterceptFrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>
</LinearLayout>